# Modo normal: contas reais e banco vazio, separado da demonstração antiga.
APP_MODE=product
FREE_ONLY=true
API_HOST=127.0.0.1
# Ative somente atrás de HTTPS. No acesso local por HTTP, mantenha false.
COOKIE_SECURE=false
# Limites conservadores por espaço/dia (máximos de 10 imagens e 20 chamadas de texto).
IMAGE_DAILY_LIMIT=10
TEXT_DAILY_LIMIT=20
# DATA_DIR pode apontar para outro volume persistente; padrão: data/product.

# Porta da API (também serve o front-end buildado em produção)
PORT=3001

# Banco: deixe vazio para usar PGlite (Postgres embutido em arquivo, zero setup).
# Em produção aponte para um Postgres real (Azure Database for PostgreSQL, Neon, Supabase...).
DATABASE_URL=

# Segredo para assinar tokens de sessão
JWT_SECRET=generate-a-new-random-secret-for-your-installation

# Provedor de IA: cloudflare (camada gratuita), mock, openai, azure-openai, anthropic
# "mock" funciona sem chave (respostas determinísticas) — bom para desenvolver e para backup da demo.
AI_PROVIDER=cloudflare
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Modelos reserva (separados por vírgula) usados se o principal estiver sobrecarregado (503/429)
OPENAI_FALLBACK_MODELS=
# Para Gemini: https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_BASE_URL=https://api.openai.com/v1
# Tempo máximo de espera por resposta da IA (ms); ao estourar, tenta o próximo modelo
AI_TIMEOUT_MS=120000
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Notificações de aprovação (opcional): URL de webhook de um fluxo do Teams (Workflows) ou Incoming Webhook
TEAMS_WEBHOOK_URL=
# URL pública do app, usada nos links das notificações
APP_PUBLIC_URL=http://localhost:5173

# Caminho do Chromium para exportação PNG (opcional; o Playwright encontra sozinho na maioria dos casos)
CHROMIUM_PATH=

# Geração REAL de artes e textos com Cloudflare Workers AI, camada gratuita com limite diário.
# Não é necessário cadastrar cartão no plano Workers Free; monitore sua cota no painel.
# Gere Account ID e token em https://dash.cloudflare.com/ → Workers AI → Use REST API.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
IMAGE_AI_ENABLED=true
# Usada apenas no modo antigo de demonstração. No produto, a sessão e o papel autorizam a geração.
IMAGE_GENERATION_SECRET=
IMAGE_TIMEOUT_MS=180000
